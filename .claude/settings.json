{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(cmd /c npx -y skills *)",
      "Bash(vercel ls*)",
      "Bash(vercel inspect*)",
      "Bash(vercel logs*)",
      "Bash(vercel env ls*)",
      "Bash(cmd /c npm audit*)",
      "Bash(cmd /c npm ls*)",
      "Bash(node --check *)",
      "Bash(cmd /c firebase --version)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(.env*)",
      "Read(**/*.pem)",
      "Read(**/*service-account*)"
    ]
  }
}
